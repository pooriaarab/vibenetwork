{
  "name": "vibenetwork",
  "version": "0.1.4",
  "description": "Peer-to-peer social network for AI coders with Hyperswarm discovery, ed25519 signed posts, local follows, direct messages, and MCP tools.",
  "type": "module",
  "license": "MIT",
  "author": "Pooria Arab",
  "bin": {
    "vibenetwork": "./dist/cli.js",
    "vibenetwork-mcp": "./dist/mcp.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/mcp.ts --format esm --dts --clean --no-splitting",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pooriaarab/vibe-core": "^0.6.0",
    "hyperswarm": "^4.17.0",
    "zod": "^3.25 || ^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "hyperdht": "^6.33.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.0",
    "werift": "^0.24.1"
  },
  "mcpName": "io.github.pooriaarab/vibenetwork",
  "keywords": [
    "peer-to-peer",
    "social-network",
    "ai-coding",
    "hyperswarm",
    "ed25519",
    "signed-posts",
    "direct-messages",
    "mcp",
    "cli",
    "local-first",
    "claude-code",
    "codex",
    "gemini",
    "cline",
    "kimi"
  ]
}
